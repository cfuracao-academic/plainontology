{
  "metadata": {
    "dbt_schema_version": "https://schemas.getdbt.com/dbt/manifest/v12.json",
    "dbt_version": "1.9.0",
    "project_name": "corner_shop"
  },
  "nodes": {
    "model.corner_shop.stg_orders": {
      "resource_type": "model",
      "name": "stg_orders",
      "unique_id": "model.corner_shop.stg_orders",
      "description": "Orders as they arrive from the till, one row per order.",
      "columns": {
        "order_id": {"name": "order_id", "description": "Till order number.", "data_type": "integer"},
        "customer_id": {"name": "customer_id", "description": "", "data_type": "integer"},
        "ordered_at": {"name": "ordered_at", "description": "", "data_type": "timestamp"},
        "status": {"name": "status", "description": "Where the order is now.", "data_type": "varchar"}
      },
      "depends_on": {"nodes": ["source.corner_shop.till.orders"]}
    },
    "model.corner_shop.customers": {
      "resource_type": "model",
      "name": "customers",
      "unique_id": "model.corner_shop.customers",
      "description": "One row per customer, with their order history summarised.",
      "columns": {
        "customer_id": {
          "name": "customer_id",
          "description": "",
          "data_type": "integer",
          "constraints": [{"type": "primary_key"}]
        },
        "name": {"name": "name", "description": "Name on the loyalty card.", "data_type": "text"},
        "lifetime_spend": {"name": "lifetime_spend", "description": "Total spent, in pounds.", "data_type": "numeric(12,2)"}
      },
      "depends_on": {"nodes": ["model.corner_shop.stg_orders", "source.corner_shop.till.customers"]}
    },
    "model.corner_shop.orders": {
      "resource_type": "model",
      "name": "orders",
      "unique_id": "model.corner_shop.orders",
      "description": "Completed orders with their value.",
      "columns": {
        "order_id": {"name": "order_id", "description": "", "data_type": "integer"},
        "customer_id": {"name": "customer_id", "description": "Who placed the order.", "data_type": "integer"},
        "amount": {"name": "amount", "description": "Order value in pounds.", "data_type": "numeric(10,2)"},
        "status": {"name": "status", "description": "", "data_type": "varchar"}
      },
      "depends_on": {"nodes": ["model.corner_shop.stg_orders"]}
    },
    "test.corner_shop.unique_orders_order_id": {
      "resource_type": "test",
      "name": "unique_orders_order_id",
      "attached_node": "model.corner_shop.orders",
      "column_name": "order_id",
      "test_metadata": {"name": "unique", "kwargs": {"column_name": "order_id", "model": "{{ get_where_subquery(ref('orders')) }}"}},
      "depends_on": {"nodes": ["model.corner_shop.orders"]}
    },
    "test.corner_shop.not_null_orders_order_id": {
      "resource_type": "test",
      "name": "not_null_orders_order_id",
      "attached_node": "model.corner_shop.orders",
      "column_name": "order_id",
      "test_metadata": {"name": "not_null", "kwargs": {"column_name": "order_id"}},
      "depends_on": {"nodes": ["model.corner_shop.orders"]}
    },
    "test.corner_shop.accepted_values_orders_status": {
      "resource_type": "test",
      "name": "accepted_values_orders_status",
      "attached_node": "model.corner_shop.orders",
      "column_name": "status",
      "test_metadata": {"name": "accepted_values", "kwargs": {"column_name": "status", "values": ["placed", "shipped", "returned"]}},
      "depends_on": {"nodes": ["model.corner_shop.orders"]}
    },
    "test.corner_shop.relationships_orders_customer_id": {
      "resource_type": "test",
      "name": "relationships_orders_customer_id__customer_id__ref_customers_",
      "attached_node": "model.corner_shop.orders",
      "column_name": "customer_id",
      "test_metadata": {"name": "relationships", "kwargs": {"column_name": "customer_id", "to": "ref('customers')", "field": "customer_id"}},
      "depends_on": {"nodes": ["model.corner_shop.customers", "model.corner_shop.orders"]}
    },
    "test.corner_shop.accepted_range_orders_amount": {
      "resource_type": "test",
      "name": "dbt_utils_accepted_range_orders_amount__0",
      "attached_node": "model.corner_shop.orders",
      "column_name": "amount",
      "test_metadata": {"name": "accepted_range", "namespace": "dbt_utils", "kwargs": {"column_name": "amount", "min_value": 0}},
      "depends_on": {"nodes": ["model.corner_shop.orders"]}
    },
    "test.corner_shop.not_null_customers_name": {
      "resource_type": "test",
      "name": "not_null_customers_name",
      "attached_node": "model.corner_shop.customers",
      "column_name": "name",
      "test_metadata": {"name": "not_null", "kwargs": {"column_name": "name"}},
      "depends_on": {"nodes": ["model.corner_shop.customers"]}
    }
  },
  "sources": {
    "source.corner_shop.till.orders": {
      "resource_type": "source",
      "name": "orders",
      "source_name": "till",
      "unique_id": "source.corner_shop.till.orders",
      "description": "Raw orders exported nightly from the till.",
      "columns": {}
    },
    "source.corner_shop.till.customers": {
      "resource_type": "source",
      "name": "customers",
      "source_name": "till",
      "unique_id": "source.corner_shop.till.customers",
      "description": "Raw loyalty card holders.",
      "columns": {}
    }
  },
  "semantic_models": {
    "semantic_model.corner_shop.orders": {
      "name": "orders",
      "model": "ref('orders')",
      "measures": [
        {"name": "order_total", "agg": "sum", "expr": "amount", "description": "Sum of order values."},
        {"name": "order_count", "agg": "count", "expr": "order_id"}
      ],
      "dimensions": [
        {"name": "status", "type": "categorical"}
      ],
      "depends_on": {"nodes": ["model.corner_shop.orders"]}
    }
  }
}
