{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reviewer",
  "description": "A person who checks an article before it goes live; defined in its own file.",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "email": {
      "type": "string",
      "format": "email"
    }
  },
  "required": [
    "name"
  ]
}
