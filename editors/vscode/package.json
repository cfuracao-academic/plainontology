{
  "name": "plainontology",
  "displayName": "PlainOntology",
  "description": "Syntax highlighting for PlainOntology .onto files: concepts, properties, rules, language tags and [auto] lines.",
  "version": "0.2.0",
  "publisher": "cfuracao-academic",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/cfuracao-academic/plainontology"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": ["Programming Languages"],
  "keywords": ["ontology", "semantic layer", "plainontology", "onto"],
  "contributes": {
    "languages": [
      {
        "id": "plainontology",
        "aliases": ["PlainOntology", "onto"],
        "extensions": [".onto"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "plainontology",
        "scopeName": "source.onto",
        "path": "./syntaxes/onto.tmLanguage.json"
      }
    ]
  }
}
